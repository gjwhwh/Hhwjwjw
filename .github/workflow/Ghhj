@Composable
private fun GlassBackground(content: @Composable BoxScope.() -> Unit) {
    Box(Modifier.fillMaxSize().background(Brush.verticalGradient(listOf(Ink, Deep)))) {
        Box(
            Modifier.align(Alignment.TopStart).offset((-90).dp, 40.dp).size(300.dp)
                .blur(100.dp, BlurredEdgeTreatment.Unbounded).background(Aqua.copy(.45f), CircleShape)
        )
        Box(
            Modifier.align(Alignment.CenterEnd).offset(90.dp, 120.dp).size(280.dp)
                .blur(100.dp, BlurredEdgeTreatment.Unbounded).background(Violet.copy(.40f), CircleShape)
        )
        Box(
            Modifier.align(Alignment.BottomStart).offset((-60).dp, 60.dp).size(240.dp)
                .blur(100.dp, BlurredEdgeTreatment.Unbounded).background(Coral.copy(.22f), CircleShape)
        )
        content()
    }
}

@Composable
private fun GlassCard(
    modifier: Modifier = Modifier,
    shape: RoundedCornerShape = RoundedCornerShape(22.dp),
    content: @Composable ColumnScope.() -> Unit,
) {
    Column(
        modifier
            .clip(shape)
            .background(Brush.linearGradient(listOf(Color.White.copy(.16f), Color.White.copy(.05f))))
            .border(
                BorderStroke(1.dp, Brush.linearGradient(listOf(Color.White.copy(.45f), Color.White.copy(.04f)))),
                shape
            )
            .padding(16.dp),
        content = content,
    )
}

@Composable
private fun ConnectOrb(connected: Boolean, onClick: () -> Unit) {
    val pulse by rememberInfiniteTransition(label = "pulse").animateFloat(
        1f, 1.18f,
        infiniteRepeatable(tween(1600, easing = FastOutSlowInEasing), RepeatMode.Reverse),
        label = "s"
    )
    val tint = if (connected) Aqua else Color.White
    Box(contentAlignment = Alignment.Center, modifier = Modifier.size(210.dp)) {
        if (connected) Box(
            Modifier.size(170.dp).scale(pulse).alpha(.35f).border(2.dp, Aqua, CircleShape)
        )
        Box(
            Modifier.size(170.dp).clip(CircleShape)
                .background(Brush.radialGradient(listOf(tint.copy(.32f), tint.copy(.08f))))
                .border(1.5.dp, Brush.linearGradient(listOf(tint.copy(.8f), tint.copy(.08f))), CircleShape)
                .clickable(onClick = onClick),
            contentAlignment = Alignment.Center,
        ) {
            Text(
                if (connected) "قطع کن" else "وصل شو",
                color = TextMain, fontSize = 22.sp, fontWeight = FontWeight.SemiBold
            )
        }
    }
}

@Composable
private fun ServerRow(s: Server, selected: Boolean, onSelect: () -> Unit, onDelete: () -> Unit) {
    val shape = RoundedCornerShape(18.dp)
    Row(
        Modifier.fillMaxWidth().clip(shape)
            .background(Color.White.copy(if (selected) .16f else .07f))
            .border(1.dp, if (selected) Aqua.copy(.7f) else Color.White.copy(.12f), shape)
            .clickable(onClick = onSelect).padding(14.dp),
        verticalAlignment = Alignment.CenterVertically,
    ) {
        Column(Modifier.weight(1f)) {
            Text(s.name, color = TextMain, fontSize = 15.sp, fontWeight = FontWeight.Medium, maxLines = 1)
            Text("${s.protocol}  ${s.host}:${s.port}", color = TextDim, fontSize = 12.sp, maxLines = 1)
        }
        val ping = s.pingMs
        Text(
            when {
                ping == null -> "—"
                ping < 0 -> "خطا"
                else -> "$ping ms"
            },
            color = when {
                ping == null -> TextDim
                ping < 0 -> Coral
                ping < 300 -> Aqua
                else -> Color(0xFFFFC857)
            },
            fontSize = 13.sp,
        )
        Text(
            "✕", color = TextDim, fontSize = 16.sp,
            modifier = Modifier.padding(start = 14.dp).clickable(onClick = onDelete)
        )
    }
}

@Composable
private fun GlassButton(label: String, modifier: Modifier = Modifier, onClick: () -> Unit) {
    val shape = RoundedCornerShape(16.dp)
    Box(
        modifier.clip(shape).background(Color.White.copy(.10f))
            .border(1.dp, Color.White.copy(.25f), shape)
            .clickable(onClick = onClick).padding(vertical = 14.dp),
        contentAlignment = Alignment.Center,
    ) { Text(label, color = TextMain, fontSize = 14.sp) }
}

/* ───────────── صفحه‌ی اصلی ───────────── */

@Composable
fun GlassRayApp(vm: MainVM, onToggle: () -> Unit) {
    val servers by vm.servers.collectAsStateWithLifecycle()
    val selectedId by vm.selectedId.collectAsStateWithLifecycle()
    val connected by VpnState.connected.collectAsStateWithLifecycle()
    val clipboard = LocalClipboardManager.current
    var message by remember { mutableStateOf<String?>(null) }
    val current = servers.firstOrNull { it.id == selectedId }

    CompositionLocalProvider(LocalLayoutDirection provides LayoutDirection.Rtl) {
        GlassBackground {
            Column(
                Modifier.fillMaxSize().statusBarsPadding().navigationBarsPadding()
                    .padding(horizontal = 20.dp),
                horizontalAlignment = Alignment.CenterHorizontally,
            ) {
                Spacer(Modifier.height(20.dp))
                Text("GlassRay", color = TextMain, fontSize = 26.sp, fontWeight = FontWeight.Bold)
                Text(
                    if (connected) "متصل هستی" else "قطع است",
                    color = if (connected) Aqua else TextDim, fontSize = 14.sp
                )

                ConnectOrb(connected) {
                    if (current == null) message = "اول یک سرور اضافه کن" else onToggle()
                }

                GlassCard(Modifier.fillMaxWidth()) {
                    Text("سرور انتخاب‌شده", color = TextDim, fontSize = 12.sp)
                    Spacer(Modifier.height(4.dp))
                    Text(
                        current?.name ?: "هنوز سروری اضافه نشده",
                        color = TextMain, fontSize = 17.sp, fontWeight = FontWeight.Medium
                    )
                }

                message?.let {
                    Spacer(Modifier.height(8.dp))
                    Text(it, color = Coral, fontSize = 13.sp)
                }

                Spacer(Modifier.height(14.dp))
                LazyColumn(Modifier.weight(1f), verticalArrangement = Arrangement.spacedBy(10.dp)) {
                    items(servers, key = { it.id }) { s ->
                        ServerRow(
                            s, s.id == selectedId,
                            onSelect = { vm.select(s.id) },
                            onDelete = { vm.delete(s.id) }
                        )
                    }
                }

                Row(
                    Modifier.fillMaxWidth().padding(vertical = 14.dp),
                    horizontalArrangement = Arrangement.spacedBy(10.dp)
                ) {
                    GlassButton("افزودن از کلیپ‌بورد", Modifier.weight(1f)) {
                        val n = vm.import(clipboard.getText()?.text.orEmpty())
                        message = if (n == 0) "لینک معتبری در کلیپ‌بورد نبود (vmess / vless / trojan / ss)" else null
                    }
                    GlassButton("تست پینگ", Modifier.weight(1f)) { vm.pingAll() }
                }
            }
        }
    }
}

class MainActivity : ComponentActivity() {
    private val vm by viewModels<MainVM>()

    private val vpnPermission =
        registerForActivityResult(ActivityResultContracts.StartActivityForResult()) {
            if (it.resultCode == RESULT_OK) startVpn()
        }

    override fun onCreate(savedInstanceState: Bundle?) {
        super.onCreate(savedInstanceState)
        enableEdgeToEdge()
        setContent { GlassRayApp(vm, onToggle = ::toggle) }
    }

    private fun toggle() {
        if (VpnState.connected.value) {
            startService(Intent(this, GlassVpnService::class.java).setAction(ACTION_STOP))
        } else {
            val ask = VpnService.prepare(this)
            if (ask != null) vpnPermission.launch(ask) else startVpn()
        }
    }

    private fun startVpn() {
        val server = vm.selected() ?: return
        startService(Intent(this, GlassVpnService::class.java).putExtra(EXTRA_LINK, server.raw))
    }
}
