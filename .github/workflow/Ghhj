/* ───────────── مدل و پارسر لینک ───────────── */

data class Server(
    val id: String,
    val name: String,
    val protocol: String,
    val host: String,
    val port: Int,
    val raw: String,
    val pingMs: Int? = null,
)

object LinkParser {
    fun parse(text: String): List<Server> =
        text.lineSequence().map { it.trim() }.filter { it.contains("://") }
            .mapNotNull { runCatching { one(it) }.getOrNull() }.toList()

    private fun one(link: String): Server? {
        val scheme = link.substringBefore("://").lowercase()
        if (scheme == "vmess") {
            val body = link.removePrefix("vmess://")
            val j = JSONObject(String(Base64.decode(body, Base64.DEFAULT)))
            val host = j.getString("add")
            val port = j.optString("port").toInt()
            return Server(UUID.randomUUID().toString(), j.optString("ps", host), "vmess", host, port, link)
        }
        if (scheme in listOf("vless", "trojan", "ss")) {
            val u = URI(link)
            val name = u.rawFragment?.let { URLDecoder.decode(it, "UTF-8") } ?: u.host
            return Server(UUID.randomUUID().toString(), name, scheme, u.host, u.port, link)
        }
        return null
    }
}

/* ───────────── ذخیره‌سازی ───────────── */

class ServerStore(ctx: Context) {
    private val sp = ctx.getSharedPreferences("glassray", Context.MODE_PRIVATE)

    fun load(): List<Server> {
        val arr = JSONArray(sp.getString("servers", "[]"))
        return (0 until arr.length()).map {
            val o = arr.getJSONObject(it)
            Server(
                o.getString("id"), o.getString("name"), o.getString("protocol"),
                o.getString("host"), o.getInt("port"), o.getString("raw")
            )
        }
    }

    fun save(list: List<Server>) {
        val arr = JSONArray()
        list.forEach {
            arr.put(
                JSONObject().put("id", it.id).put("name", it.name).put("protocol", it.protocol)
                    .put("host", it.host).put("port", it.port).put("raw", it.raw)
            )
        }
        sp.edit().putString("servers", arr.toString()).apply()
    }

    fun selected(): String? = sp.getString("selected", null)
    fun select(id: String?) = sp.edit().putString("selected", id).apply()
}

