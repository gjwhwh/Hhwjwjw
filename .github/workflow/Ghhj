/** بعد از اتصال هسته این را true کن تا کل ترافیک از TUN عبور کند */
const val CORE_READY = false
const val ACTION_STOP = "com.example.glassray.STOP"
const val EXTRA_LINK = "link"

class GlassVpnService : VpnService() {
    private var tun: ParcelFileDescriptor? = null

    override fun onStartCommand(intent: Intent?, flags: Int, startId: Int): Int {
        if (intent?.action == ACTION_STOP) {
            closeTun(); stopSelf(); return START_NOT_STICKY
        }
        startVpn(intent?.getStringExtra(EXTRA_LINK).orEmpty())
        return START_NOT_STICKY
    }

    private fun startVpn(link: String) {
        closeTun()
        val b = Builder()
            .setSession("GlassRay")
            .addAddress("10.10.0.2", 32)
            .addDnsServer("1.1.1.1")
            .setMtu(1500)
        // تا وقتی هسته وصل نشده، کل ترافیک را به TUN نمی‌بریم تا اینترنت قطع نشود
        if (CORE_READY) b.addRoute("0.0.0.0", 0) else b.addRoute("10.10.0.0", 24)
        tun = b.establish()
        tun?.let { CoreBridge.start(link, it.fd); VpnState.connected.value = true }
    }

    private fun closeTun() {
        CoreBridge.stop()
        tun?.close(); tun = null
        VpnState.connected.value = false
    }

    override fun onDestroy() {
        closeTun(); super.onDestroy()
    }
}

/* ───────────── ViewModel ───────────── */

class MainVM(app: Application) : AndroidViewModel(app) {
    private val store = ServerStore(app)
    private val _servers = MutableStateFlow(store.load())
    val servers: StateFlow<List<Server>> = _servers
    private val _selectedId = MutableStateFlow(store.selected())
    val selectedId: StateFlow<String?> = _selectedId

    fun selected(): Server? = _servers.value.firstOrNull { it.id == _selectedId.value }

    fun import(text: String): Int {
        val found = LinkParser.parse(text)
        if (found.isEmpty()) return 0
        _servers.value = _servers.value + found
        store.save(_servers.value)
        if (_selectedId.value == null) select(found.first().id)
        return found.size
    }

    fun select(id: String) {
        _selectedId.value = id; store.select(id)
    }

    fun delete(id: String) {
        _servers.value = _servers.value.filterNot { it.id == id }
        store.save(_servers.value)
        if (_selectedId.value == id) {
            _selectedId.value = _servers.value.firstOrNull()?.id
            store.select(_selectedId.value)
        }
    }

    fun pingAll() = viewModelScope.launch(Dispatchers.IO) {
        val result = _servers.value.map { s ->
            async {
                val ms = runCatching {
                    val t = System.nanoTime()
                    Socket().use { it.connect(InetSocketAddress(s.host, s.port), 2500) }
                    ((System.nanoTime() - t) / 1_000_000).toInt()
                }.getOrDefault(-1)
                s.copy(pingMs = ms)
            }
        }.awaitAll()
        _servers.value = result
    }
}

